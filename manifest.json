{
  "manifest_version": 3,
  "name": "iPaaS Helper",
  "version": "0.1.2",
  "description": "Helper for the TOTVS iPaaS web application: session, builder, execution, and tracking helpers.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ipaas.totvs.app/",
    "https://api-ipaas.totvs.app/",
    "https://api-fluig.totvs.app/"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ipaas.totvs.app/*"
      ],
      "js": [
        "src/content.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
