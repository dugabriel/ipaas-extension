{
  "name": "ipaas-helper-extension",
  "version": "0.1.0",
  "description": "Chrome MV3 helper extension for the TOTVS iPaaS web application",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && cd dist && zip -r ../ipaas-helper.zip . && cd .."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.287",
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "sinon-chrome": "^3.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
